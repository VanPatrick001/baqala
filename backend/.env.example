# --- Serveur API ---
PORT=4000
# 0.0.0.0 : accessible depuis le réseau local et Tailscale. Mettez 127.0.0.1 pour limiter à ce PC.
HOST=0.0.0.0
NODE_ENV=development
# Origine autorisée du front (Vite)
CORS_ORIGIN=http://localhost:5173

# --- MySQL local ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=baqala
DB_PASSWORD=baqala_pwd
DB_NAME=baqala
# Compte administrateur MySQL, utilisé uniquement par "npm run db:init"
DB_ROOT_USER=root
DB_ROOT_PASSWORD=

# --- Sécurité ---
# Remplacez par une longue chaîne aléatoire (ex. openssl rand -hex 32)
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_EXPIRES_IN=12h

# --- Smart Agent ---
# Expression cron (par défaut : toutes les heures à la minute 5)
AGENT_CRON=5 * * * *
AGENT_ENABLED=true
